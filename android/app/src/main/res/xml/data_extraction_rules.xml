<?xml version="1.0" encoding="utf-8"?>
<!--
  data_extraction_rules.xml - Android 12+ (API 31+) veri cikartma kurallari (Fix #18)
  Hassas veriler hariç tutulur; etkinlik/rutin verileri yedeklenebilir.
-->
<data-extraction-rules>
    <!-- Bulut Yedekleme (Google Drive) -->
    <cloud-backup>
        <!-- Auth tokenlarini ve sifreleme anahtarlarini hariç tut -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="supabase_auth.xml" />
        <exclude domain="sharedpref" path="supabase.xml" />
        <!-- Diger tum SharedPreferences yedeklenir (etkinlikler, rutinler, widget ayarlari) -->
    </cloud-backup>

    <!-- Cihazlar Arasi Aktarim -->
    <device-to-device>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="supabase_auth.xml" />
        <exclude domain="sharedpref" path="supabase.xml" />
    </device-to-device>
</data-extraction-rules>
