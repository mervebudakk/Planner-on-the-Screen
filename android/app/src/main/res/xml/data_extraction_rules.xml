<?xml version="1.0" encoding="utf-8"?>
<!--
    🔒 GÜVENLİK: Android 12+ (API 31+) veri çıkarma kuralları.
    SharedPreferences ve veritabanı dahil tüm uygulama verilerini
    hem bulut yedeklemesinden hem de cihazlar arası aktarımdan hariç tutar.
    Bu sayede ADB backup ve Google Drive backup yoluyla plaintext
    plan verisinin sızması engellenir (OWASP M8 / M9).
-->
<data-extraction-rules>
    <!-- Bulut Yedekleme (Google Drive) -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="cache" path="." />
    </cloud-backup>

    <!-- Cihazlar Arası Aktarım (Device-to-Device Transfer) -->
    <device-to-device>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="cache" path="." />
    </device-to-device>
</data-extraction-rules>
