<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A281E"
    android:padding="14dp">

    <!-- Başlık: Bugünün Planı -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bug&#252;n&#252;n Plan&#305;"
        android:textColor="#EAF3EC"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Plan 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="3.5dp"
            android:layout_height="32dp"
            android:src="@drawable/widget_bar_bg"
            android:tint="#DAEAF6"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Psikoloji 101"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B Blok Amfi 2"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:30 - 10:00"
            android:textColor="#CCFFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_bell"
            android:tint="#CCFFFFFF"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Plan 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="3.5dp"
            android:layout_height="32dp"
            android:src="@drawable/widget_bar_bg"
            android:tint="#E8DFF5"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K&#252;t&#252;phanede &#199;al&#305;&#351;ma"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bireysel &#199;al&#305;&#351;ma Alan&#305;"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:30 - 12:30"
            android:textColor="#CCFFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_bell"
            android:tint="#CCFFFFFF"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Plan 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="3.5dp"
            android:layout_height="32dp"
            android:src="@drawable/widget_bar_bg"
            android:tint="#FFDAC1"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#214;&#287;le Molas&#305; &amp; Kahve"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kamp&#252;s Bah&#231;esi"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:30 - 13:30"
            android:textColor="#CCFFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_bell"
            android:tint="#CCFFFFFF"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>