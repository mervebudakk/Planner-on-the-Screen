<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="12dp">

    <!-- Header: Gün ve Tarih -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_day_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bugünün Planı"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/widget_app_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aesthetic Planner"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <!-- Dinamik Etkinlik Listesi Konteyneri -->
    <LinearLayout
        android:id="@+id/widget_events_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Örnek / Varsayılan 1. Etkinlik -->
        <LinearLayout
            android:id="@+id/widget_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">

            <View
                android:id="@+id/widget_item_1_bar"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:background="#60A5FA"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_item_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Business class"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <TextView
                    android:id="@+id/widget_item_1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 - 12:00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Örnek / Varsayılan 2. Etkinlik -->
        <LinearLayout
            android:id="@+id/widget_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">

            <View
                android:id="@+id/widget_item_2_bar"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:background="#F472B6"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_item_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Part-time shift"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <TextView
                    android:id="@+id/widget_item_2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13:00 - 16:00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Örnek / Varsayılan 3. Etkinlik -->
        <LinearLayout
            android:id="@+id/widget_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical">

            <View
                android:id="@+id/widget_item_3_bar"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:background="#FBBF24"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_item_3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trader Joe's"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <TextView
                    android:id="@+id/widget_item_3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="17:30"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
